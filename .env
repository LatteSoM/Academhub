# Настройки PostgreSQL
NAME=academhub_db                  # Имя базы данных
USER_DB=academhub_user             # Пользователь PostgreSQL
PASSWORD=strong_db_password123     # Пароль PostgreSQL

# Настройки Django
SUPERUSER=admin@admin.admin                    # Имя суперпользователя Django
SUPERUSER_PASSWORD=admin        # Пароль суперпользователя
SECRET_KEY='django-insecure-your-secret-key-here'  # Секретный ключ Django
DEBUG=1                            # Режим отладки (1 - включен, 0 - выключен)
ALLOWED_HOSTS=localhost,127.0.0.1  # Разрешенные хосты (через запятую)

# Настройки подключения к БД
HOST=postgres                      # Хост БД (имя сервиса в docker-compose)
PORT=5432                          # Порт PostgreSQL

# Настройки Nginx
TZ=Europe/Moscow                   # Часовой пояс для Nginx

# Дополнительные настройки
POSTGRES_HOST_AUTH_METHOD=trust    # Метод аутентификации PostgreSQL